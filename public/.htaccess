Options -MultiViews
RewriteEngine On

# Force React routes to index.html even if a same-named folder exists
# (this was breaking /testimonials because of the PDF folder)
RewriteRule ^(about|testimonials|contact|services|news|tours)/?$ /index.html [NC,L]

# Nested tour pages
RewriteRule ^tours/.+ /index.html [NC,L]

# Don't rewrite real files (PDFs, images, JS, CSS, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
